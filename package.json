{
  "name": "jeasx-develop",
  "type": "module",
  "scripts": {
    "start": "node cli.js start",
    "build": "node cli.js build",
    "dev": "node cli.js dev",
    "clean": "node cli.js clean",
    "test": "node -e \"fs.rmSync('dist-test',{recursive:true,force:true})\" && esbuild \"src/**/*.test.*\" --bundle --platform=node --format=esm --packages=external --loader:.svg=file --outbase=src --outdir=dist-test --log-level=warning && node --test dist-test",
    "test:bun": "bun test src",
    "compile": "esbuild --platform=node --format=esm --sourcemap=linked --outdir=. serverless.ts",
    "compile:bun": "bun build --target=node --packages=external --sourcemap=linked --define process.env.NODE_ENV=process.env.NODE_ENV --outdir=. serverless.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/send": "4.2.1",
    "@preact/signals": "2.11.4",
    "capjs-core": "0.1.20",
    "cheerio": "1.2.0",
    "fastify": "5.12.8",
    "jsx-async-runtime": "3.0.2",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "prettier": "3.10.1",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "svelte": "5.59.1",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@lit-labs/motion": "1.1.0",
    "@mdx-js/esbuild": "3.1.1",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "alpinejs": "3.17.5",
    "cap-widget": "0.1.64",
    "esbuild": "0.28.2",
    "esbuild-svelte": "0.9.5",
    "htmx.org": "4.0.2",
    "lit": "3.3.3",
    "rehype-prism-plus": "2.0.2",
    "unplugin-vue": "8.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "sharp": true
  }
}
